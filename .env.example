# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer Supabase's current publishable key for browser auth; legacy anon key remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude semantic analysis
ANTHROPIC_API_KEY=sk-ant-your-key

# Pepper for new API key hashes. Existing SHA-256 hashes still work during migration;
# production readiness requires this value.
# If not set, legacy SHA-256 hashing will be used.
# Generate production secrets with: openssl rand -base64 32
INTENTGUARD_SECRET=your-random-256bit-secret

# Dedicated secret for signed httpOnly dashboard sessions.
# Required in production; local/test environments may fall back to shared secrets.
# Use a unique generated value; do not reuse this across apps.
DASHBOARD_SESSION_SECRET=your-random-dashboard-session-secret

# Dedicated HMAC key for signed audit logs.
# Required in production; local/test environments may fall back for development only.
# Use a unique generated value; rotating this currently requires keeping old records verifiable separately.
AUDIT_SIGNING_SECRET=your-random-audit-signing-secret
# Optional comma-separated old audit signing secrets used only to verify historical records after rotation.
AUDIT_SIGNING_PREVIOUS_SECRETS=

# Dedicated HMAC key for signed mandates.
# If not set, Aurel falls back to AUDIT_SIGNING_SECRET, INTENTGUARD_SECRET, then SUPABASE_SERVICE_ROLE_KEY.
# Use a unique generated value; mandate signatures depend on this value.
MANDATE_SIGNING_SECRET=your-random-mandate-signing-secret
# Optional comma-separated old mandate signing secrets used only to verify historical mandates after rotation.
MANDATE_SIGNING_PREVIOUS_SECRETS=

# Aurel action-plugin clients
AUREL_API_URL=http://localhost:3000
AUREL_API_KEY=
AUREL_FAIL_MODE=closed
# Payment velocity storage failures fail closed in production by default. Pilot-only override: open.
AUREL_VELOCITY_FAIL_MODE=closed
AUREL_FAIL_OPEN_PRIVILEGED_ACTIONS=block
AUREL_TIMEOUT_MS=1500
AUREL_STATE_TTL_MS=600000
AUREL_LOG_LEVEL=warn
AUREL_TELEMETRY_ENABLED=true
AUREL_ENABLED=true
AUREL_TOOLS_INCLUDE=
AUREL_TOOLS_EXCLUDE=
AUREL_TELEMETRY_INCLUDE_RESULTS=false
AUREL_TELEMETRY_MAX_PAYLOAD_BYTES=32768
AUREL_REDACTION_ENABLED=true
AUREL_HOOK_MAX_STDIN_BYTES=1048576
AUREL_MCP_MAX_FRAME_BYTES=1048576
AUREL_MCP_PENDING_TTL_MS=600000
AUREL_HERMES_NATIVE_APPROVAL=false
AUREL_OPENCLAW_NATIVE_APPROVAL=false

# Distributed rate limiting with Upstash Redis (required for production)
# Local/test environments may omit it and use the in-memory fallback.
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Required for external/manual cron calls. Vercel Cron calls can be configured
# to include Authorization: Bearer <CRON_SECRET>.
# Use a generated value with at least 32 characters.
CRON_SECRET=your-random-cron-secret

# Browser origins allowed to call the API with credentials (CORS).
# Required in production; server-to-server integrations can omit Origin.
ALLOWED_ORIGINS=https://your-agent.example.com

# Optional: hosted support/ticket ingestion webhook
SUPPORT_WEBHOOK_URL=https://your-ticketing-provider.example.com/aurel
SUPPORT_WEBHOOK_SECRET=your-random-support-webhook-secret

# Optional provider-owned billing. Leave BILLING_PROVIDER empty for manual pilot billing.
# When enabled, all Stripe prices, limits, and return URL settings are required.
BILLING_PROVIDER=
BILLING_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PILOT=
STRIPE_PRICE_ENTERPRISE=
# JSON values are positive verification limits; null means unlimited.
STRIPE_PLAN_LIMITS={"starter":1000,"pilot":10000,"enterprise":null}
