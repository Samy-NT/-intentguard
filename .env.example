# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IntentGuard internal secret for signing (used to hash API keys)
INTENTGUARD_SECRET=your-random-256bit-secret

# Optional: restrict which origins can call the API
ALLOWED_ORIGINS=https://your-agent.example.com
