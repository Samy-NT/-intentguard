{
  "name": "aurel",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./sdk": "./lib/sdk/index.ts",
    "./sdk/adapters": "./lib/sdk/adapters.ts",
    "./actions/protocol": "./lib/actions/protocol.ts"
  },
  "scripts": {
    "dev": "cross-env CHOKIDAR_USEPOLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:openclaw": "vitest run tests/openclaw-aurel.test.ts",
    "test:agent-integrations": "vitest run tests/openclaw-aurel.test.ts tests/next-integrations.test.ts tests/claude-code-hook.test.ts tests/mcp-proxy.test.ts tests/package-agent-integrations.test.ts && npm run test:hermes && npm run test:crewai",
    "test:e2e:agent-integrations": "node scripts/e2e-agent-integrations.mjs",
    "test:hermes": "python -m unittest discover -s integrations/hermes/tests",
    "test:crewai": "python -m unittest discover -s integrations/crewai/tests",
    "build:openclaw-plugin": "tsc -p integrations/openclaw/tsconfig.json",
    "smoke:openclaw-plugin": "node -e \"import('./integrations/openclaw/dist/index.js').then((m)=>{ if (m.default?.id !== 'aurel' || typeof m.default?.register !== 'function') process.exit(1); })\"",
    "package:openclaw-plugin": "cd integrations/openclaw && npm pack --dry-run",
    "build:hermes-plugin": "python -m compileall -q integrations/hermes",
    "package:hermes-plugin": "tar -acf outputs/aurel-hermes-plugin.zip -C integrations/hermes plugin.yaml __init__.py README.md aurel_hermes/__init__.py aurel_hermes/client.py aurel_hermes/config.py aurel_hermes/plugin.py aurel_hermes/redaction.py",
    "build:crewai-integration": "python -m compileall -q integrations/crewai",
    "package:crewai-integration": "tar -acf outputs/aurel-crewai-integration.zip -C integrations/crewai README.md aurel_crewai/__init__.py aurel_crewai/guard.py aurel_crewai/redaction.py",
    "package:codex-plugin": "tar -acf outputs/aurel-codex-plugin.zip -C integrations/codex/aurel-codex-plugin .codex-plugin/plugin.json .mcp.json README.md scripts/aurel-protected-mcp.mjs",
    "package:agent-integrations": "node scripts/package-agent-integrations.mjs",
    "dev:aurel-harness": "node integrations/dev-harness/mock-aurel-server.mjs",
    "benchmark": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./benchmark/register.mjs benchmark/run.ts",
    "benchmark:e2e:ollama": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./benchmark/register.mjs benchmark/e2e-ollama.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "lucide-react": "^1.21.0",
    "next": "^16.3.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
